<!-- Piece 7 -->
<link name="obstacle_7">
  <visual>
    <geometry>
      <cylinder length="0.2" radius="0.2"/>
    </geometry>
    <material name="green"/>
  </visual>
  <collision>
    <geometry>
      <cylinder length="0.2" radius="0.2"/>
